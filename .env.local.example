# .env.local.example
# Copy this file to .env.local for local development.
# Set these same values in Vercel project settings for production.

ADMIN_PASSWORD=your_secret_password

# Upstash Redis (Vercel KV) — injected automatically by Vercel when a
# Redis integration is linked, or set manually for local dev:
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token
